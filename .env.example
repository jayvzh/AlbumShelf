# AlbumShelf 开发环境配置模板（复制为 .env 后生效；.env 已被 gitignore，不会提交）
# scripts/dev.sh 启动时自动加载；命令行已显式设置的同名环境变量优先于本文件

# 登录模式：AUTH_PASSWORD 非空即启用（收藏 / 设置 / 私有目录需登录）；
# 留空 AUTH_PASSWORD 即游客模式（无需登录，收藏与设置全开放）
AUTH_USERNAME=admin
AUTH_PASSWORD=

# 会话有效期（可选，默认 168h = 7 天）
#SESSION_MAX_AGE=168h

# 图片根目录 / 数据目录（可选，默认仓库内 images/ 与 data/）
#IMAGE_ROOT=
#DATA_DIR=
