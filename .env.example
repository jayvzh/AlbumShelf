# 图片根目录（宿主机路径；容器内只读挂载为 /images）
IMAGE_ROOT=./images

# 数据目录（缩略图缓存 + SQLite 数据库）
DATA_DIR=./data

# 浏览器访问端口（宿主端口，映射到容器内 8080；容器内监听端口固定 8080）
# 开发模式（scripts/dev.sh）不使用本变量：前端 :5160 / 后端 :8080
PORT=8160

# ---- 登录系统（示例缺省值：用户名 admin123 / 密码 admin12345）----
# 管理员用户名（示例缺省值 admin123；AUTH_PASSWORD 留空时登录系统整体关闭，行为与无认证一致）
AUTH_USERNAME=admin123
# 管理员密码（示例缺省值 admin12345）：设置后启用登录：私有目录对游客隐藏、设置页/管理端点需登录
# 置空（AUTH_PASSWORD=）即关闭登录系统，回到游客模式
AUTH_PASSWORD=admin12345
# 会话有效期（Go time.ParseDuration 格式，默认 168h = 7 天；非法值回退默认）
#SESSION_MAX_AGE=168h
